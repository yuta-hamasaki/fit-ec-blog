# microCMS: service domain only (do not include .microcms.io)
MICROCMS_SERVICE_DOMAIN=your-service
MICROCMS_API_KEY=your-read-api-key

# Supabase: these values are server-only. Never prefix the service role key with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
